[Unit]
Description=Lisenok FastAPI site
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lisenok
Environment=PATH=/opt/lisenok/.venv/bin
ExecStart=/opt/lisenok/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
